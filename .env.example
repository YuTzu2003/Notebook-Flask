# APP_ENV=development 為開發模式（Flask debugger）， production 為正式模式（使用Waitress啟動）
APP_ENV=development
APP_DEBUG=true

# 應用程式密鑰，正式環境請務必更換。
# 產生安全密鑰的指令： uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development-only-change-before-production

# 資料庫連線
DATABASE_URL=mssql+pyodbc://user:password@127.0.0.1:1433/Hospital?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

WAITRESS_THREADS=16
TRUSTED_PROXY=127.0.0.1
PROXY_COUNT=1
MAX_UPLOAD_MB=200

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=28800

ENABLE_SCHEDULER=false
DB_BACKUP_DATABASE=Hospital
DB_BACKUP_PATH=C:/backups/Hospital_.bak