# APP_ENV=development 為開發模式（Flask debugger），production 為正式模式（Waitress + Nginx）
APP_ENV=development
APP_DEBUG=true

# 產生安全密鑰的指令： uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development-only-change-before-production

# 資料庫連線
DATABASE_URL=mssql+pyodbc://user:password@127.0.0.1:1433/Notebook?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 2 Core / 16 GB RAM：單一 Web 程序 + 單一 PDF Queue Worker。
APP_WORKERS=1
PUBLIC_HTTP_PORT=80
BACKEND_BASE_PORT=50001
WAITRESS_HOST=127.0.0.1

# WAITRESS_PORT 由正式部署腳本依 BACKEND_BASE_PORT 自動設定。
WAITRESS_THREADS=8
WAITRESS_BACKLOG=256
WAITRESS_CONNECTION_LIMIT=256
WAITRESS_CHANNEL_TIMEOUT=300

PDF_TASK_CONCURRENCY=1
TRUSTED_PROXY=127.0.0.1
PROXY_COUNT=1
MAX_UPLOAD_MB=200

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=28800

ENABLE_SCHEDULER=false
DB_BACKUP_DATABASE=Notebook
DB_BACKUP_PATH=C:/backups/Notebook_.bak